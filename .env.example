# --- Core ---
POSTGRES_USER=rino
POSTGRES_PASSWORD=rino
POSTGRES_DB=rino
DATABASE_URL=postgresql+psycopg://rino:rino@postgres:5432/rino
REDIS_URL=redis://redis:6379/0

# --- App URLs (browser-facing) ---
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
# Next.js server → backend (inside compose use http://backend:8000)
INTERNAL_API_URL=http://backend:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Sessions (use a long random string in real use) ---
SESSION_SECRET=change-me-to-a-long-random-string

# --- GitHub OAuth App (user login) ---
# Create at https://github.com/settings/developers → OAuth Apps
# Homepage URL: http://localhost:3000
# Authorization callback URL: http://localhost:8000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- GitHub App (repo access / Repository Setup) ---
# Create at https://github.com/settings/apps → New GitHub App
# See README for permissions and URLs.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Optional: App's own OAuth credentials (if distinct from the OAuth App above)
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# PEM private key — paste with literal \n OR set a file path
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_WEBHOOK_SECRET=

# Comma-separated GitHub usernames that become Admin on first login
# (creates the default org + membership if missing)
BOOTSTRAP_ADMIN_GITHUB_USERNAMES=your-github-username

# Optional: default org name used when bootstrapping the first admin
DEFAULT_ORG_NAME=Rino
DEFAULT_ORG_SLUG=rino

# CORS / cookie
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Sandbox runner (Step 3) ---
# Worker needs Docker socket mounted (see docker-compose.yml).
# Workdirs use the compose named volume `sandbox_data` (rino_sandbox_data).
RINO_SAMPLES_DIR=/samples
RINO_SANDBOX_WORK_DIR=/var/rino/sandbox
RINO_SANDBOX_VOLUME=rino_sandbox_data
RINO_SANDBOX_TIMEOUT_SECONDS=600
RINO_SANDBOX_MEMORY=1g
RINO_SANDBOX_CPUS=1.0
# Set to 1 to keep workdirs for debugging
RINO_SANDBOX_KEEP=0

# --- LLM (Step 5: root-cause for Critical/High only) ---
# Create a key at https://console.anthropic.com/
# Never commit real keys. The API key is never written to logs or llm_calls.
ANTHROPIC_API_KEY=
# Model id passed to the Anthropic Messages API
LLM_MODEL=claude-sonnet-4-20250514
# Optional USD / million tokens for cost accounting in llm_calls
LLM_INPUT_COST_PER_MTOK=3.0
LLM_OUTPUT_COST_PER_MTOK=15.0

# --- GitHub Issues (Step 5 confirm) ---
# When true (default), Confirm creates a dry-run:// URL if the GitHub App
# is not configured or the repo is local/* — useful for samples/junit-demo.
GITHUB_ISSUE_DRY_RUN=true

# --- Draft PRs (Step 7 approve) ---
# When true (default), Approve & Open Draft PR records dry-run:// and does not
# push. Rino only ever pushes branches under rino/ (e.g. rino/fix-412).
GITHUB_PR_DRY_RUN=true

# --- GitHub Actions runner (Step 8) ---
# When true (default), GitHubActionsRunner uses a fixture JUnit XML and does
# not call workflow_dispatch. Set false only with a real App install + repo
# workflow that has `on: workflow_dispatch` and uploads a JUnit artifact
# (name containing "junit" or "rino-junit").
GITHUB_ACTIONS_DRY_RUN=true
# Optional: wall clock for Actions poll (seconds)
RINO_ACTIONS_TIMEOUT_SECONDS=900
RINO_ACTIONS_JUNIT_ARTIFACT=rino-junit
# Webhook URL (App settings): https://<ngrok-host>/webhooks/github
# Events: workflow_run, installation, ping. Set GITHUB_APP_WEBHOOK_SECRET above.
